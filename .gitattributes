# CRV Science Labs (bio-suite) — GitHub Linguist & Code Search Indexing Rules
* text=auto eol=lf

# Core Rust source and test suites (100% indexed by GitHub Code Search)
src/*.rs linguist-language=Rust
tests/*.rs linguist-language=Rust

# Mark Cargo.lock as generated so it does not skew repository language stats or search ranking
Cargo.lock linguist-generated=true

# Standalone compiled preprint PDFs (binary release archives < 100 MB; excluded from UTF-8 text search indexing)
Preprints/*.pdf binary linguist-generated=true
